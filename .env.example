# Supabase project → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this site (used in auth email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Error tracking (optional). From sentry.io > Project > Client Keys (DSN). Off when empty.
NEXT_PUBLIC_SENTRY_DSN=
# Readable stack traces: a Sentry auth token with project:releases scope, plus org and project slugs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
